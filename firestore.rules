rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email in [
          "jonathanalafi@gmail.com",
          "muhwezipetros@gmail.com"
        ];
    }

    // A signed-in guest may bump "likes" by exactly one and touch nothing else.
    function isLikeIncrement() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.likes + 1;
    }

    function isValidComment() {
      return request.auth != null
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
    }

    // Two independent category systems, both publicly readable so the site
    // can render them, both owner-only for writes.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /comicCategories/{categoryId} {
      allow read: if true;
      allow write: if isOwner();
    }

    match /artworks/{artId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || isLikeIncrement();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidComment();
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // A comic is a story: cover image plus an ordered page sequence.
    match /comics/{comicId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner() || isLikeIncrement();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidComment();
        allow update: if false;
        allow delete: if isOwner();
      }
    }

    // Collection-group read so the admin panel can list every comment at once.
    // Comment threads are already public above, so this exposes nothing new.
    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }
  }
}
