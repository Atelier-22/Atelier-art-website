rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function hasAdminClaim() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function isOwnerEmail() {
      return request.auth != null
        && request.auth.token.email in [
          "jonathanalafi@gmail.com",
          "muhwezipetros@gmail.com"
        ];
    }

    function isAdmin() {
      return hasAdminClaim() || isOwnerEmail();
    }

    function signedIn() {
      return request.auth != null;
    }

    function isPublished() {
      return resource.data.status == "published";
    }

    function notFound() {
      return resource == null;
    }

    function incomingIsValidStatus() {
      return request.resource.data.status in ["draft", "published"];
    }

    function isLikeIncrement() {
      return signedIn()
        && resource.data.status == "published"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes == resource.data.get('likes', 0) + 1;
    }

    function isValidComment() {
      return signedIn()
        && request.resource.data.keys().hasOnly(['name', 'text', 'uid', 'createdAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 300
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
    }

    match /siteConfig/published {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteConfig/draft {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /artCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /comicCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /artworks/{artId} {
      allow get: if isAdmin() || notFound() || isPublished();
      allow list: if isAdmin() || isPublished();
      allow create: if isAdmin() && incomingIsValidStatus();
      allow update: if (isAdmin() && incomingIsValidStatus()) || isLikeIncrement();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidComment();
        allow update, delete: if isAdmin();
      }
    }

    match /comics/{comicId} {
      allow get: if isAdmin() || notFound() || isPublished();
      allow list: if isAdmin() || isPublished();
      allow create: if isAdmin() && incomingIsValidStatus();
      allow update: if (isAdmin() && incomingIsValidStatus()) || isLikeIncrement();
      allow delete: if isAdmin();

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isValidComment();
        allow update, delete: if isAdmin();
      }

      match /chapters/{chapterId} {
        allow read, write: if isAdmin();

        match /pages/{pageId} {
          allow read, write: if isAdmin();
        }
      }
    }

    match /media/{mediaId} {
      allow read, write: if isAdmin();
    }

    match /changeLog/{entryId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /contentDeletions/{deletionId} {
      allow read, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read, delete: if isAdmin();
    }

    match /stories/{storyId} {
      allow read, delete: if isAdmin();
    }
  }
}
